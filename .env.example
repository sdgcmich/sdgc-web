# ==============================================================================
# Saugatuck Douglas Garden Club - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Retrieve local keys with `npm run db:status`.
# NEVER commit real secret keys, service-role keys, or webhook secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site & App Routing Configuration
# ------------------------------------------------------------------------------
# Local dev: http://127.0.0.1:3000
# Production: https://saugatuckdouglasgardenclub.org (or custom domain)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration
# ------------------------------------------------------------------------------
# Local dev (Docker stack on port 54321):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Production:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Server/test scripts only. NEVER expose to client components or NEXT_PUBLIC_*!
# Supports either modern SUPABASE_SECRET_KEY or legacy SUPABASE_SERVICE_ROLE_KEY:
SUPABASE_SECRET_KEY=replace-with-service-or-secret-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# ------------------------------------------------------------------------------
# 3. Object Storage Configuration (Cloudinary vs Supabase Storage)
# ------------------------------------------------------------------------------
# Default is 'supabase'. Set to 'cloudinary' for Cloudinary media storage:
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ------------------------------------------------------------------------------
# 4. Payments Configuration (Stripe Sandbox / Production vs Local Simulation)
# ------------------------------------------------------------------------------
# For real Stripe payments (Sandbox or Live):
# Set LOCAL_PAYMENTS_SIMULATION=false (or leave it unset in Vercel production).
# In sandbox/test mode, keys start with sk_test_, rkcs_test_, or rk_test_.
LOCAL_PAYMENTS_SIMULATION=false

# Stripe API Keys (Server only - NEVER expose STRIPE_SECRET_KEY to client!):
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# For offline local development & integration testing ONLY:
# Set to 'true' on localhost to test dues & admissions without contacting Stripe.
# Note: Local simulation automatically fails closed on non-loopback domains and production builds.
# LOCAL_PAYMENTS_SIMULATION=true

# ------------------------------------------------------------------------------
# 5. Local Production Build Testing (Optional)
# ------------------------------------------------------------------------------
# Used exclusively by local Playwright E2E suites when testing `npm run start` (NODE_ENV=production).
# ALLOW_LOCAL_PRODUCTION_BUILD_TESTING=true
